---
// Public route for the `resumes` collection, behind Basic auth in production
// (src/middleware.ts).
import { getEmDashEntry } from "emdash";
import Base from "../../layouts/ResumeBase.astro";

// The collection holds a single entry, so the slug is pinned here rather than
// routed — /resume needs no dynamic segment.
const { entry: page, cacheHint } = await getEmDashEntry("resumes", "resume");

if (!page) {
  return Astro.redirect("/404");
}

// `experiences` は repeater フィールド (JSON カラム)。EmDash の型生成
// (emdash-env.d.ts) は repeater のサブフィールドまでは展開しないため、ここで
// 手書きの型を当てる。キー名は admin UI で定義されたサブフィールドの slug
// そのままで、すべて snake_case・値は文字列。
// 2026-08-08 修正: 型注釈が実データと乖離し ts(2339) を7件出していたため、
// 本番 D1 の ec_resumes.experiences を実測して合わせた。
// period_end は「現在も継続中」を空文字で表す (null ではない)。
const experiences = page.data.experiences as {
  title: string;
  summary: string;
  period_start: string;
  period_end: string;
  tech_stack: string;
  team_size: string;
  content: string;
  websites: string;
}[];

const skills = page.data.skills as { category: string; items: string }[];
const other = page.data.other as { label: string; url: string }[];

// repeater のサブフィールドに repeater は入れられないため、案件ごとの関連サイトは
// 「ラベル|URL」の改行区切りで 1 つの text サブフィールドに持たせている。
// URL の無い行はリンクではない注記 (例: 社内ツールのため非公開)。
function parseWebsites(raw: string) {
  return (raw ?? "")
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => {
      // ラベルに | が含まれても壊れないよう最初の | だけで区切る。
      const sep = line.indexOf("|");
      return sep === -1
        ? { label: line, url: "" }
        : { label: line.slice(0, sep).trim(), url: line.slice(sep + 1).trim() };
    });
}

const projects = experiences.map((experience) => ({
  ...experience,
  websites: parseWebsites(experience.websites),
}));

function formatPeriod(start: string, end: string) {
  const startFormatted = formatDate(start);
  const endFormatted = end ? formatDate(end) : "現在";

  return `${startFormatted} 〜 ${endFormatted}`;

  function formatDate(date: string) {
    const [year, month] = date.split(/-0?/);
    return `${year}年${month}月`;
  }
}

Astro.cache.set(cacheHint);
---

<Base>
  <header class="title-header">
    <h1 class="h1">職務経歴書</h1>
    <p
      class="flex flex-col items-end max-sm:items-start text-end max-sm:text-start"
    >
      <span class="text-md">礒田 優</span>
      <span class="text-muted">2026年6月現在</span>
    </p>
  </header>

  <main class="flex flex-col gap-y-(--rhythm-3) mt-(--rhythm-4)">
    <section class="space-y-(--rhythm-1)">
      <h2 class="h2">職務経歴概要</h2>
      <div class="prose">
        {page.data.summary}
      </div>
    </section>

    <section class="space-y-(--rhythm-1)">
      <h2 class="h2">職務経歴</h2>
      <p class="text-sm text-muted">各社在籍中に携わった案件より抜粋。</p>
      <div class="space-y-(--rhythm-4)">
        {
          projects.map((project) => (
            <article class="space-y-(--rhythm-1)">
              <header class="title-header">
                <h3 class="h3">{project.title}</h3>
                <p class="text-sm text-muted tabular-nums">
                  {formatPeriod(project.period_start, project.period_end)}
                </p>
              </header>

              <p class="font-semibold">{project.summary}</p>

              <div class="prose" set:html={project.content} />

              <dl class="grid gap-y-(--rhythm-half)">
                <div class="meta-row">
                  <dt>チーム規模</dt>
                  <dd>{project.team_size}</dd>
                </div>
                <div class="meta-row">
                  <dt>使用技術</dt>
                  <dd>{project.tech_stack}</dd>
                </div>
                {project.websites.length > 0 && (
                  <div class="meta-row">
                    <dt>Webサイト</dt>
                    <dd>
                      <ul class="flex flex-col break-all">
                        {project.websites.map((site) => (
                          <li>
                            {site.url ? (
                              <a
                                href={site.url}
                                target="_blank"
                                rel="noreferrer noopener"
                                class="link"
                              >
                                {site.label}
                              </a>
                            ) : (
                              <span class="text-muted">{site.label}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                )}
              </dl>
            </article>
          ))
        }
      </div>
    </section>

    <section class="space-y-(--rhythm-1)">
      <h2 class="h2">自己PR</h2>
      <div class="prose">
        {page.data.strengths}
      </div>
    </section>

    <section class="space-y-(--rhythm-1)">
      <h2 class="h2">スキル</h2>
      <dl class="grid gap-y-(--rhythm-half)">
        {
          skills.map((skill) => (
            <div class="meta-row">
              <dt>{skill.category}</dt>
              <dd>{skill.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="space-y-(--rhythm-1)">
      <h2 class="h2">その他</h2>
      <ul class="other">
        {
          other.map((link) => (
            <li>
              {link.url ? (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="link"
                >
                  {link.label}
                </a>
              ) : (
                link.label
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <p class="text-end mt-(--rhythm-4)">以上</p>
  </main>
</Base>
